# Laravel API base URL, reachable from the Next.js server (not exposed to the browser).
CARTIX_API_URL=http://127.0.0.1:8000/api/v1

# Public URL of this storefront, used for canonical links, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image hosts allowed for next/image optimization (comma-separated origins). The API host is always allowed.
# CARTIX_IMAGE_ORIGINS=https://cdn.cartixbd.com

# Image optimization of local addresses is allowed automatically when CARTIX_API_URL is localhost or
# 127.0.0.1. Set CARTIX_ALLOW_LOCAL_IMAGES=true only if the API uses another private address (for example a LAN IP).
# CARTIX_ALLOW_LOCAL_IMAGES=false

# Set to "true" only when the storefront is served over HTTPS, so cookies get the Secure flag.
# Defaults to true when NODE_ENV=production.
# CARTIX_SECURE_COOKIES=true
